NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Purelymail SMTP — two mailboxes. Leave a password blank to skip that mailbox.
# support@ sends order receipts and contact replies.
# info@ sends newsletter welcomes and contact notifications.
MAIL_HOST=smtp.purelymail.com
MAIL_PORT=465
MAIL_SECURE=true

MAIL_SUPPORT_USER=support@bengalot.com
MAIL_SUPPORT_PASS=
MAIL_SUPPORT_FROM="Bengalot Support <support@bengalot.com>"
MAIL_SUPPORT_REPLY_TO=support@bengalot.com

MAIL_INFO_USER=info@bengalot.com
MAIL_INFO_PASS=
MAIL_INFO_FROM="Bengalot <info@bengalot.com>"
MAIL_INFO_REPLY_TO=info@bengalot.com

MAIL_SUPPORT_EMAIL=support@bengalot.com
# Optional: where contact-form notifications go. Defaults to info@.
MAIL_CONTACT_TO=
